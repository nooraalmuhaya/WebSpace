    %% class COURSE,COURSE_LEARNING_OUTCOME,COURSE_ROADMAP,ROADMAP,ROADMAP_OBJECTIVE,ROADMAP_TOPIC,TOPIC catalog
    %% class COURSE_WEEK,LESSON,LEARNING_RESOURCE,CODING_CHALLENGE,LESSON_PROGRESS,CHALLENGE_PROGRESS content
    %% class QUIZ,QUIZ_QUESTION,QUIZ_OPTION,QUIZ_ATTEMPT,QUIZ_ATTEMPT_ANSWER,ASSIGNMENT,ASSIGNMENT_REQUIREMENT,SUBMISSION,SUBMISSION_FILE,FEEDBACK assess
